# Current example: GLM standard Chat Completions endpoint (not the Coding endpoint).
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_MODEL=glm-5.3-flash
LLM_API_KEY=replace-with-your-api-key
LLM_TOKEN_LIMIT_FIELD=max_tokens
INPUT_TOKEN_BUDGET=2000
MAX_OUTPUT_TOKENS=512
LLM_TIMEOUT_SECONDS=60.0

# To change upstream, replace the values above; do not add duplicate dotenv keys.
# GPT/OpenAI: LLM_BASE_URL=https://api.openai.com/v1/
# LLM_TOKEN_LIMIT_FIELD=max_completion_tokens; set your available Chat Completions model ID.
# Claude official compatibility layer: LLM_BASE_URL=https://api.anthropic.com/v1/
# LLM_TOKEN_LIMIT_FIELD=max_tokens; response_format is ignored upstream, so JSON relies
# on the prompt and application validation.
# DeepSeek: LLM_BASE_URL=https://api.deepseek.com
# LLM_TOKEN_LIMIT_FIELD=max_tokens; set your available model ID and API key.
# Local Ollama: LLM_BASE_URL=http://localhost:11434/v1/
# LLM_TOKEN_LIMIT_FIELD=max_tokens; LLM_API_KEY=ollama is an ignored local placeholder.
# Set the local model ID to one installed in Ollama.
