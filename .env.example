# 当前示例使用 GLM 标准 Chat Completions 端点，与 Coding 端点不同。
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_MODEL=glm-5.3-flash
LLM_API_KEY=replace-with-your-api-key
LLM_TOKEN_LIMIT_FIELD=max_tokens
INPUT_TOKEN_BUDGET=2000
MAX_OUTPUT_TOKENS=512
LLM_TIMEOUT_SECONDS=60.0

# 切换上游时替换上面的配置值，不要添加重复的 dotenv 配置项。
# GPT / OpenAI 接入：LLM_BASE_URL=https://api.openai.com/v1/
# LLM_TOKEN_LIMIT_FIELD=max_completion_tokens；模型名填写账户可用的 Chat Completions 模型 ID。
# Claude 官方兼容层：LLM_BASE_URL=https://api.anthropic.com/v1/
# LLM_TOKEN_LIMIT_FIELD=max_tokens；上游会忽略 response_format，
# 因此 JSON 输出依赖提示词和应用校验。
# DeepSeek 接入：LLM_BASE_URL=https://api.deepseek.com
# LLM_TOKEN_LIMIT_FIELD=max_tokens；填写账户可用的模型 ID 和密钥。
# 本地 Ollama：LLM_BASE_URL=http://localhost:11434/v1/
# LLM_TOKEN_LIMIT_FIELD=max_tokens；LLM_API_KEY=ollama 是本地占位值，上游会忽略它。
# 模型 ID 填写本地 Ollama 已安装的模型。
