# 本地环境配置样例：复制为 .env 后填写实际值，由 app/config.py 统一读取。
# 当前示例使用 GLM 标准 Chat Completions 端点，与 Coding 端点不同。
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_MODEL=glm-5.3-flash
LLM_API_KEY=replace-with-your-api-key
# 输出上限字段按上游协议切换，输入预算与回答输出上限分别控制。
LLM_TOKEN_LIMIT_FIELD=max_tokens
INPUT_TOKEN_BUDGET=2000
MAX_OUTPUT_TOKENS=512
# 离线历史QA单独使用2048；在线客服与售后仍使用上方512。
QA_MAX_OUTPUT_TOKENS=2048
LLM_TIMEOUT_SECONDS=60.0

# 数据库密码必须替换；Compose 首次启动按用户 DDL 和种子初始化具名卷。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=customer_service
MYSQL_USER=customer_service
MYSQL_PASSWORD=replace-with-your-database-password
MYSQL_ROOT_PASSWORD=replace-with-your-root-password
# 工具预算还包含工具 Schema、调用参数和结果，超时最多重试一次。
TOOL_INPUT_TOKEN_BUDGET=8000
TOOL_TIMEOUT_SECONDS=5
TOOL_MAX_RETRIES=1

# 硅基流动云端 Dense 嵌入；调用前替换独立密钥。
SILICONFLOW_API_KEY=replace-with-your-siliconflow-api-key
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_TIMEOUT_SECONDS=20
# 本机 Milvus SDK 端口，对应 compose.milvus.yaml 的宿主回环映射。
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TIMEOUT_SECONDS=5

# 切换上游时替换上面的配置值，不要添加重复的 dotenv 配置项。
# GPT / OpenAI 接入：LLM_BASE_URL=https://api.openai.com/v1/
# LLM_TOKEN_LIMIT_FIELD=max_completion_tokens；模型名填写账户可用的 Chat Completions 模型 ID。
# Claude 官方兼容层：LLM_BASE_URL=https://api.anthropic.com/v1/
# LLM_TOKEN_LIMIT_FIELD=max_tokens；上游会忽略 response_format，
# 因此 JSON 输出依赖提示词和应用校验。
# DeepSeek 接入：LLM_BASE_URL=https://api.deepseek.com
# LLM_TOKEN_LIMIT_FIELD=max_tokens；填写账户可用的模型 ID 和密钥。
# 本地 Ollama：LLM_BASE_URL=http://localhost:11434/v1/
# LLM_TOKEN_LIMIT_FIELD=max_tokens；LLM_API_KEY=ollama 是本地占位值，上游会忽略它。
# 模型 ID 填写本地 Ollama 已安装的模型。
