# 本地开发工作树和 IDE 设置不属于项目源码。
.worktrees/
.idea/
# 真实配置不提交，保留仅含占位值的配置样例。
.env
!.env.example
# 依赖环境、生成缓存、测试产物和临时流程文件可在本机重新生成。
.venv/
.cache/
.pytest_cache/
__pycache__/
*.py[cod]
.superpowers/
# 评估运行快照含本地裁判审计与资源归属，不进入版本库或静态目录。
runtime/rag-evaluation/
# Workflow 检查点与 SQLite 日志只保存在本机运行目录。
runtime/workflow/
# Actual model contexts contain full conversation text and remain local.
log/app.log
# Acceptance logs, screenshots, call ledger and replay results are local evidence.
runtime/context-evidence/
runtime/tool-system-evidence/
# 第九步本地密钥、追踪及安装/验收缓存不提交。
runtime/langfuse/
runtime/ch09-evidence/
runtime/ch09-sources/
runtime/uv-cache/
