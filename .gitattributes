*.sh text eol=lf
# 冻结评估资产按原始 LF 字节保存，避免 Windows checkout 改写 SHA-256。
/evals/datasets/merchant-rag-300/** text eol=lf
/knowledge-docs/evaluation-drafts/after-sales-manual.md text eol=lf
/knowledge-docs/evaluation-drafts/product-faq.md text eol=lf
/knowledge-docs/evaluation-drafts/product-specs.md text eol=lf
/knowledge-docs/evaluation-drafts/returns-policy.md text eol=lf
/knowledge-docs/evaluation-drafts/membership-benefits.md text eol=lf
/knowledge-docs/evaluation-drafts/integral-rules.md text eol=lf
/knowledge-docs/evaluation-drafts/invoice-policy.md text eol=lf
/knowledge-docs/evaluation-drafts/cat-bed-care.md text eol=lf
# 本次已发布报告按原始字节保存，保留各产物实际换行及 SHA-256。
/docs/validation/merchant-rag-interrupted.* -text
/docs/validation/merchant-rag-completion-*.* -text
/docs/validation/merchant-rag-comparison*.* -text
/docs/validation/merchant-rag-degraded-*.* -text
